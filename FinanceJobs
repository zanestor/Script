                                      default=[])),
                remote=True,
                category=as_tags(pick(j, "categories", default=[])),
                smin=pick(j, "minSalary", "salary_min"),
                smax=pick(j, "maxSalary", "salary_max"),
                currency=pick(j, "currency", default=""),
                published=pick(j, "pubDate", "publishedDate", "created_at"),
                url=pick(j, "applicationLink", "url", "guid"),
                tags=pick(j, "seniority", "tags", default=[]),
