        if not data:
            break
        jobs = data.get("data", []) if isinstance(data, dict) else data
        if not jobs:
            break
        for j in jobs:
            if not isinstance(j, dict):
                continue
            rows.append(build_row(
                source="arbeitnow",
                native_id=pick(j, "slug", "id"),
                title=pick(j, "title"),
                company=pick(j, "company_name", "company"),
                location=pick(j, "location"),
                remote=bool(pick(j, "remote", default=False)),
                category=as_tags(pick(j, "job_types", default=[])),
                smin=None, smax=None, currency="",
                published=pick(j, "created_at", "created"),
                url=pick(j, "url"),
                tags=pick(j, "tags", default=[]),
            ))
    return [r for r in rows if r]


