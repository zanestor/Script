async def run_provider(name, fn, client, sem):
    """One provider failing must never abort the whole run."""
    try:
        rows = await fn(client, sem)
        print(f"   {name:12s} {len(rows):4d} finance roles")
        return rows
    except Exception as e:
        print(f"   {name:12s} FAILED — {type(e).__name__}: {e}")
        return []


# ========== CSV MERGE ==========

def merge_and_save(new_rows, csv_path):
    """
    Dedup-append on JobID.

    Note this deliberately differs from Taux_BCC's bare drop_duplicates():
    a job re-fetched tomorrow carries a new LastSeen, so full-row dedup would
    treat it as new and grow the CSV without bound. Dedup on JobID instead,
    keeping the newest field values but restoring the original FirstSeen.
    """
    new_df = pd.DataFrame(new_rows, columns=COLUMNS)

    existing_df = pd.DataFrame(columns=COLUMNS)
    if os.path.exists(csv_path):
        try:
            existing_df = pd.read_csv(csv_path, dtype={"JobID": str})
            for col in COLUMNS:
                if col not in existing_df.columns:
                    existing_df[col] = None
            existing_df = existing_df[COLUMNS]
        except Exception as e:
            print(f"Could not read existing CSV ({e}); starting fresh.")

    if existing_df.empty:
        combined = new_df
    elif new_df.empty:
        combined = existing_df
    else:
        combined = pd.concat([existing_df, new_df], ignore_index=True)

    if combined.empty:
        print("No rows to write.")
        return combined

    # Earliest FirstSeen / latest LastSeen per job, compared as real dates.
    first_dt = pd.to_datetime(combined["FirstSeen"], format="%d/%m/%Y", errors="coerce")
    last_dt = pd.to_datetime(combined["LastSeen"], format="%d/%m/%Y", errors="coerce")
    spans = pd.DataFrame({
        "JobID": combined["JobID"], "_first": first_dt, "_last": last_dt,
    }).groupby("JobID", as_index=False).agg(_first=("_first", "min"),
                                            _last=("_last", "max"))

    # keep="last" retains the freshest title/salary for a job seen again.
    deduped = combined.drop_duplicates(subset=["JobID"], keep="last").copy()
    deduped = deduped.merge(spans, on="JobID", how="left")
    deduped["FirstSeen"] = deduped["_first"].dt.strftime("%d/%m/%Y")
    deduped["LastSeen"] = deduped["_last"].dt.strftime("%d/%m/%Y")
    deduped = deduped.drop(columns=["_first", "_last"])

    deduped = deduped.sort_values(by=["FirstSeen", "Source", "Company"],
                                  na_position="last")[COLUMNS]
    deduped.to_csv(csv_path, index=False)

    added = len(deduped) - len(existing_df)
    print(f"\nCSV updated: {csv_path}")
    print(f"   {len(deduped)} jobs total ({added} new this run)")
    return deduped


# ========== PROBE MODE ==========

async def probe():
    """Dump raw shapes so schema drift can be diagnosed without guesswork."""
    targets = [
        ("remotive", "https://remotive.com/api/remote-jobs?category=finance-legal", "jobs"),
        ("remoteok", "https://remoteok.com/api", None),
        ("arbeitnow", "https://www.arbeitnow.com/api/job-board-api", "data"),
        ("himalayas", "https://himalayas.app/jobs/api?limit=3", "jobs"),
    ]
    sem = asyncio.Semaphore(MAX_CONCURRENCY)
    async with httpx.AsyncClient(follow_redirects=True) as client:
        for name, url, key in targets:
            print("=" * 68)
            print(name, url)
            print("=" * 68)
            data = await fetch_json(client, url, sem)
            if data is None:
                print("  no data\n")
                continue
            if isinstance(data, dict):
                print("  top-level keys:", list(data.keys()))
                items = data.get(key, []) if key else []
            else:
                print(f"  top-level list, len={len(data)}")
                items = data
            sample = next((i for i in items if isinstance(i, dict) and "legal" not in i), None)
            if sample:
                print("  first record fields:")
                for k, v in sample.items():
                    prev = str(v)
                    print(f"    {k:32s} {type(v).__name__:8s} {prev[:60]}")
            print()


# ========== SELF-TEST (offline) ==========

def self_test():
    """Offline checks for classification and CSV merge. No network required."""
    import tempfile
    failures = []

    def check(label, cond):
        print(f"  {'PASS' if cond else 'FAIL'}  {label}")
        if not cond:
            failures.append(label)

    print("Classifier — should ACCEPT:")
    for t in ["Senior Accountant", "Finance Manager", "Financial Controller",
              "Payroll Specialist", "Tax Analyst", "FP&A Lead",
              "Accounts Payable Clerk", "Bookkeeper", "Treasury Analyst",
              "Internal Auditor", "Grants Accountant", "CFO"]:
        check(f"accept {t!r}", classify(t)[0])

    print("Classifier — should REJECT:")
    for t in ["Account Manager", "Account Executive", "Enterprise Sales Lead",
              "Corporate Attorney", "Paralegal", "Legal Counsel",
              "Technical Recruiter", "Software Engineer", "Product Designer",
              "Marketing Manager", "Syntax Researcher", "Taxonomy Specialist",
              "Customer Success Manager"]:
        check(f"reject {t!r}", not classify(t)[0])

    print("Classifier — tag fallback:")
    check("accept via tags", classify("Remote Specialist", tags="finance, ifrs")[0])
    check("negative title beats positive tags",
          not classify("Account Manager", tags="finance")[0])
    check("matched keywords recorded",
          classify("Senior Accountant")[1].startswith("title:"))

    print("Date normalization:")
    check("ISO-8601 string", to_ddmmyyyy("2026-07-01T10:00:00") == "01/07/2026")
    check("ISO-8601 with zone", to_ddmmyyyy("2026-06-15T08:00:00+00:00") == "15/06/2026")
    # Arbeitnow sends epoch seconds; a bare int is read as nanoseconds by
    # pd.to_datetime and would silently collapse to 1970-01-01.
    check("epoch seconds as int", to_ddmmyyyy(1751328000) == "01/07/2025")
    check("epoch seconds as string", to_ddmmyyyy("1751328000") == "01/07/2025")
    check("epoch milliseconds", to_ddmmyyyy(1751328000000) == "01/07/2025")
    check("empty date is blank", to_ddmmyyyy(None) == "" and to_ddmmyyyy("") == "")
    check("garbage date is blank", to_ddmmyyyy("not a date") == "")

    print("CSV merge:")
    with tempfile.TemporaryDirectory() as tmp:
        path = os.path.join(tmp, "jobs.csv")
        row = build_row("test", "1", "Senior Accountant", "ACME", "Remote",
                        True, "", None, None, "", "2026-01-15",
                        "https://x.test/1", ["finance"])
        check("build_row returns a finance row", row is not None)
        check("build_row filters non-finance",
              build_row("test", "2", "Account Manager", "ACME", "Remote", True,
                        "", None, None, "", "2026-01-15", "https://x.test/2", []) is None)
        check("PublishedDate is dd/mm/yyyy", row["PublishedDate"] == "15/01/2026")

        # Pin the seen-dates so the assertions do not depend on today's date.
        row["FirstSeen"] = row["LastSeen"] = "15/01/2026"
        first = merge_and_save([row], path)
        check("first run writes 1 row", len(first) == 1)

        # Same job seen again on a strictly later day.
        row2 = dict(row)
        row2["FirstSeen"] = row2["LastSeen"] = "20/02/2026"
        second = merge_and_save([row2], path)
        check("second run does not duplicate", len(second) == 1)
        check("FirstSeen preserved from run 1",
              second.iloc[0]["FirstSeen"] == "15/01/2026")
        check("LastSeen advanced to run 2",
              second.iloc[0]["LastSeen"] == "20/02/2026")

        third = merge_and_save([], path)
        check("empty run leaves CSV intact", len(third) == 1)

        distinct = build_row("test", "9", "Tax Manager", "OTHER", "Remote", True,
                             "", None, None, "", "2026-03-01",
                             "https://x.test/9", [])
        fourth = merge_and_save([distinct], path)
        check("distinct job is appended", len(fourth) == 2)

    print(f"\n{'ALL CHECKS PASSED' if not failures else str(len(failures)) + ' FAILURE(S): ' + '; '.join(failures)}")
    return 1 if failures else 0


# ========== MAIN ==========

async def collect():
    print(f"Collecting finance jobs — {datetime.now():%Y-%m-%d %H:%M:%S}")
    enabled = []
    for name, fn in PROVIDERS:
        if name == "adzuna" and not (ADZUNA_APP_ID and ADZUNA_APP_KEY):
            continue
        if name == "jsearch" and not RAPIDAPI_KEY:
            continue
        enabled.append((name, fn))
    print(f"Providers: {', '.join(n for n, _ in enabled)}\n")

    sem = asyncio.Semaphore(MAX_CONCURRENCY)
    async with httpx.AsyncClient(follow_redirects=True) as client:
        results = await asyncio.gather(
            *[run_provider(n, f, client, sem) for n, f in enabled]
        )

    rows = [r for group in results for r in group]
    if not rows:
        print("\nNo finance roles returned. Run with --probe to check the APIs.")
    merge_and_save(rows, OUTPUT_CSV_FILE)


def main():
    if "--self-test" in sys.argv:
        sys.exit(self_test())
    if "--probe" in sys.argv:
        asyncio.run(probe())
        return
    asyncio.run(collect())


if __name__ == "__main__":
    main()
