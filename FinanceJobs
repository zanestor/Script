# ========== FINANCE CLASSIFICATION ==========
# Word-boundary regexes, not substrings: "\btax\b" must not fire on "syntax",
# and "\baccount(ant|ing)\b" must not fire on "Account Manager" (a sales role).

POSITIVE_PATTERNS = [
    r"\bcfo\b", r"\bchief financial officer\b",
    r"\bfinanc(e|es|ial|ials)\b",
    r"\baccount(ant|ants|ancy|ing)\b",
    r"\baccounts (payable|receivable)\b",
    r"\bbookkeep(er|ers|ing)\b",
    r"\bcontroller\b", r"\bcomptroller\b",
    r"\btreasur(y|er)\b",
    r"\baudit(s|or|ors|ing)?\b",
    r"\bpayroll\b",
    r"\btax(es|ation)?\b",
    r"\bfp&a\b",
    r"\bactuar(y|ial|ies)\b",
    r"\bunderwrit(er|ers|ing)\b",
    r"\bcredit (analyst|risk|control|controller)\b",
    r"\binvestment(s)?\b",
    r"\bbudget(s|ing)?\b",
    r"\bfund accounting\b",
    r"\b(ifrs|gaap|cpa|acca|cima|cfa)\b",
    r"\bbilling\b", r"\binvoic(e|es|ing)\b",
    r"\breconciliation(s)?\b",
    r"\bgrants? (finance|accountant|management)\b",
]

# A negative in the TITLE rejects the row outright, even on a positive hit.
# "Account Manager"/"Account Executive" are sales; Remotive's category is
# "finance-legal", so it ships lawyers that must be filtered out.
NEGATIVE_PATTERNS = [
    r"\baccount (manager|executive|director|supervisor|coordinator)\b",
    r"\bsales\b",
    r"\battorney(s)?\b", r"\blawyer(s)?\b", r"\bparalegal\b",
    r"\b(legal|general|corporate|associate) counsel\b", r"\bsolicitor\b",
    r"\blegal\b",
    r"\brecruit(er|ers|ing|ment)\b",
    r"\bbusiness development\b",
    r"\bcustomer success\b",
    r"\bmarketing\b",
]

POSITIVE_RE = [re.compile(p, re.I) for p in POSITIVE_PATTERNS]
NEGATIVE_RE = [re.compile(p, re.I) for p in NEGATIVE_PATTERNS]


def _hits(text, patterns):
    """Return the distinct matched substrings for the given patterns."""
    if not text:
        return []
    found = []
    for rx in patterns:
        m = rx.search(text)
        if m and m.group(0).lower() not in found:
            found.append(m.group(0).lower())
    return found


def classify(title, tags="", category=""):
    """
    Decide whether a posting is a finance role.

    Returns (is_finance, matched_keywords). matched_keywords is prefixed with
    how it matched ("title:" or "tags:") so the filter can be tuned by reading
    the CSV instead of guessing.

    Rule:
      * any negative in the title  -> reject, no matter what else matched
      * positive in the title      -> accept
      * positive in tags/category  -> accept (title already known negative-clean)
    """
    title = title or ""
    blob_tags = " ".join(filter(None, [tags or "", category or ""]))

    if _hits(title, NEGATIVE_RE):
        return False, ""

    title_hits = _hits(title, POSITIVE_RE)
    if title_hits:
        return True, "title:" + ",".join(title_hits)

    tag_hits = _hits(blob_tags, POSITIVE_RE)
    if tag_hits:
        return True, "tags:" + ",".join(tag_hits)

    return False, ""


# ========== HELPERS ==========

def pick(record, *keys, default=None):
    """
    First non-empty value among several candidate key names.

    These are third-party APIs whose field names drift between versions, so
    every adapter accepts more than one plausible spelling rather than
    hard-failing on a rename.
    """
    for k in keys:
        if k in record:
            v = record[k]
            if v not in (None, "", [], {}):
                return v
    return default


def as_tags(value):
    if isinstance(value, (list, tuple)):
        return ", ".join(str(v) for v in value if v)
    return str(value) if value else ""


def to_ddmmyyyy(value):
    """
    Normalize any provider date into the repo's dd/mm/yyyy convention.

    Providers are inconsistent: Remotive and Himalayas send ISO-8601 strings,
    Arbeitnow sends an epoch integer. A bare int handed to pd.to_datetime is
    read as NANOSECONDS and silently yields 1970-01-01, so numeric values are
    given an explicit unit here.
    """
    if value in (None, "", []):
        return ""

    numeric = None
    if isinstance(value, bool):
        return ""
    if isinstance(value, (int, float)):
        numeric = float(value)
    elif isinstance(value, str) and value.strip().isdigit():
        numeric = float(value.strip())

    try:
        if numeric is not None:
            # Heuristic on magnitude: seconds ~1e9, milliseconds ~1e12.
            unit = "s" if abs(numeric) < 1e11 else "ms"
            dt = pd.to_datetime(numeric, unit=unit, errors="coerce", utc=True)
        else:
            dt = pd.to_datetime(value, errors="coerce", utc=True)
        if pd.isna(dt):
            return ""
        return dt.strftime("%d/%m/%Y")
    except Exception:
        return ""


def make_job_id(source, native_id, company, title, url):
    if native_id:
        return f"{source}:{native_id}"
    digest = hashlib.sha1(
        "|".join([source, str(company), str(title), str(url)]).encode("utf-8")
    ).hexdigest()[:12]
    return f"{source}:{digest}"


def build_row(source, native_id, title, company, location, remote, category,
              smin, smax, currency, published, url, tags):
    """Normalize one provider record, returning None if it isn't a finance role."""
    tags_str = as_tags(tags)
    is_finance, matched = classify(title, tags_str, category)
    if not is_finance:
        return None
    today = date.today().strftime("%d/%m/%Y")
    return {
        "JobID": make_job_id(source, native_id, company, title, url),
        "Source": source,
        "Title": (title or "").strip(),
        "Company": (str(company) or "").strip(),
        "Location": (str(location) if location else "").strip(),
        "Remote": bool(remote),
        "Category": (str(category) if category else "").strip(),
        "SalaryMin": smin,
        "SalaryMax": smax,
        "SalaryCurrency": currency or "",
        "PublishedDate": to_ddmmyyyy(published),
        "FirstSeen": today,
        "LastSeen": today,
        "URL": (str(url) if url else "").strip(),
        "Tags": tags_str,
        "MatchedKeywords": matched,
    }


async def fetch_json(client, url, semaphore, headers=None, params=None):
    """GET with bounded concurrency and exponential backoff. 404 short-circuits."""
    hdrs = {"User-Agent": USER_AGENT, "Accept": "application/json"}
    if headers:
        hdrs.update(headers)

    async with semaphore:
        for attempt in range(1, MAX_RETRIES + 1):
            try:
                r = await client.get(url, headers=hdrs, params=params,
                                     timeout=REQUEST_TIMEOUT)
                if r.status_code == 404:
                    print(f"   404 {url} — skipping retries")
                    return None
                r.raise_for_status()
                return r.json()
            except Exception as e:
                print(f"   attempt {attempt}/{MAX_RETRIES} failed for {url}: "
                      f"{type(e).__name__}: {e}")
                if attempt == MAX_RETRIES:
                    return None
                await asyncio.sleep(2 * attempt)
    return None


# ========== PROVIDER ADAPTERS ==========
# Each returns a list of normalized rows (already finance-filtered).

async def fetch_remotive(client, sem):
    data = await fetch_json(
        client, "https://remotive.com/api/remote-jobs",
        sem, params={"category": "finance-legal"},
    )
    if not data:
        return []
    jobs = data.get("jobs", []) if isinstance(data, dict) else data
    rows = []
    for j in jobs:
        if not isinstance(j, dict):
            continue
        rows.append(build_row(
            source="remotive",
            native_id=pick(j, "id"),
            title=pick(j, "title"),
            company=pick(j, "company_name", "company"),
            location=pick(j, "candidate_required_location", "location"),
            remote=True,
            category=pick(j, "category"),
            smin=None, smax=None,
            currency=pick(j, "salary"),
            published=pick(j, "publication_date", "published_at", "created_at"),
            url=pick(j, "url", "job_url"),
            tags=pick(j, "tags", default=[]),
        ))
    return [r for r in rows if r]


async def fetch_remoteok(client, sem):
    # RemoteOK rejects generic user agents; element [0] is a legal notice.
    data = await fetch_json(client, "https://remoteok.com/api", sem)
    if not data or not isinstance(data, list):
        return []
    rows = []
    for j in data:
        if not isinstance(j, dict) or "legal" in j:
            continue
        rows.append(build_row(
            source="remoteok",
            native_id=pick(j, "id", "slug"),
            title=pick(j, "position", "title"),
            company=pick(j, "company"),
            location=pick(j, "location"),
            remote=True,
            category="",
            smin=pick(j, "salary_min"),
            smax=pick(j, "salary_max"),
            currency="USD" if pick(j, "salary_min") else "",
            published=pick(j, "date", "created_at"),
            url=pick(j, "url", "apply_url"),
            tags=pick(j, "tags", default=[]),
        ))
    return [r for r in rows if r]


