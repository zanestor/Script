    return [r for r in rows if r]


async def fetch_adzuna(client, sem):
    """Optional — needs ADZUNA_APP_ID / ADZUNA_APP_KEY. Free tier: 1000 calls/mo."""
    if not (ADZUNA_APP_ID and ADZUNA_APP_KEY):
        return []
    rows = []
    for cc in ADZUNA_COUNTRIES:
        data = await fetch_json(
            client, f"https://api.adzuna.com/v1/api/jobs/{cc}/search/1", sem,
            params={
                "app_id": ADZUNA_APP_ID,
                "app_key": ADZUNA_APP_KEY,
                "results_per_page": 50,
                "category": "accounting-finance-jobs",
                "what": "remote",
                "content-type": "application/json",
            },
        )
        if not data:
            continue
        for j in data.get("results", []):
            if not isinstance(j, dict):
                continue
            company = j.get("company") or {}
            loc = j.get("location") or {}
            cat = j.get("category") or {}
            rows.append(build_row(
                source=f"adzuna-{cc}",
                native_id=pick(j, "id"),
                title=pick(j, "title"),
                company=company.get("display_name") if isinstance(company, dict) else company,
                location=loc.get("display_name") if isinstance(loc, dict) else loc,
                remote=True,
                category=cat.get("label") if isinstance(cat, dict) else cat,
                smin=pick(j, "salary_min"),
                smax=pick(j, "salary_max"),
                currency=cc.upper(),
                published=pick(j, "created"),
                url=pick(j, "redirect_url"),
                tags="",
            ))
    return [r for r in rows if r]


